{
  "info": {
    "_postman_id": "3b70ef55-1bb7-4c4d-bdf0-1c3e8e92e573",
    "name": "Repilche API Smoke Test",
    "description": "Smoke test local: registro, login, catálogo, agregar al carrito y crear un pedido. Requiere al menos un producto disponible, aprobado y con stock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "access",
      "value": "",
      "type": "string"
    },
    {
      "key": "smoke_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Registro",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('smoke_email', `postman-${Date.now()}@repilche.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.test('La respuesta contiene usuario y tokens', function () {",
              "    pm.expect(data).to.have.property('user');",
              "    pm.expect(data.user).to.have.property('email', pm.collectionVariables.get('smoke_email'));",
              "    pm.expect(data.user).to.have.property('first_name');",
              "    pm.expect(data).to.have.property('tokens');",
              "    pm.expect(data).to.have.property('access', data.tokens.access);",
              "    pm.expect(data).to.have.property('refresh', data.tokens.refresh);",
              "    pm.expect(data.tokens).to.have.property('access').that.is.a('string').and.not.empty;",
              "    pm.expect(data.tokens).to.have.property('refresh').that.is.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman\",\n  \"lastName\": \"Smoke Test\",\n  \"numberPhone\": \"2804123456\",\n  \"email\": \"{{smoke_email}}\",\n  \"password\": \"RepilcheSmokeTest!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/registro/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "registro",
            ""
          ]
        },
        "description": "Registra una cuenta de prueba con un email generado para esta ejecución."
      },
      "response": []
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.test('La respuesta contiene access, refresh y usuario', function () {",
              "    pm.expect(data).to.have.property('access').that.is.a('string').and.not.empty;",
              "    pm.expect(data).to.have.property('refresh').that.is.a('string').and.not.empty;",
              "    pm.expect(data).to.have.property('user');",
              "    pm.expect(data.user).to.have.property('email', pm.collectionVariables.get('smoke_email'));",
              "});",
              "pm.collectionVariables.set('access', data.access);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{smoke_email}}\",\n  \"password\": \"RepilcheSmokeTest!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login",
            ""
          ]
        },
        "description": "Inicia sesión y guarda response.access en la variable de colección access."
      },
      "response": []
    },
    {
      "name": "3. Listar productos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.test('La respuesta contiene paginación de productos', function () {",
              "    pm.expect(data).to.have.property('count').that.is.a('number');",
              "    pm.expect(data).to.have.property('results').that.is.an('array').and.not.empty;",
              "});",
              "pm.collectionVariables.set('producto_id', String(data.results[0].id));",
              "pm.test('El producto elegido está disponible y aprobado', function () {",
              "    pm.expect(data.results[0]).to.have.property('id');",
              "    pm.expect(data.results[0]).to.have.property('estado', 'DISPONIBLE');",
              "    pm.expect(data.results[0]).to.have.property('estado_moderacion', 'APROBADO');",
              "    pm.expect(data.results[0].stock).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            ""
          ]
        },
        "description": "Lista pública de productos. Selecciona el primer producto disponible y aprobado con stock para usarlo en el carrito."
      },
      "response": []
    },
    {
      "name": "4. Agregar producto al carrito",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.test('La respuesta contiene el carrito actualizado', function () {",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data).to.have.property('total_items', 1);",
              "    pm.expect(data).to.have.property('total');",
              "    pm.expect(data).to.have.property('items').that.is.an('array').and.not.empty;",
              "    pm.expect(data.items[0]).to.have.property('producto', Number(pm.collectionVariables.get('producto_id')));",
              "    pm.expect(data.items[0]).to.have.property('cantidad', 1);",
              "    pm.expect(data.items[0]).to.have.property('subtotal');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"producto\": \"{{producto_id}}\",\n  \"cantidad\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/cart/add_item/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "cart",
            "add_item",
            ""
          ]
        },
        "description": "Agrega una unidad del producto seleccionado al carrito del usuario autenticado."
      },
      "response": []
    },
    {
      "name": "5. Crear pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.test('La respuesta contiene el pedido creado', function () {",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data).to.have.property('total');",
              "    pm.expect(data).to.have.property('estado_pago');",
              "    pm.expect(data).to.have.property('codigo_secreto').that.is.a('string').and.has.lengthOf(6);",
              "    pm.expect(data).to.have.property('items').that.is.an('array').and.not.empty;",
              "    pm.expect(data.items[0]).to.have.property('cantidad', 1);",
              "    pm.expect(data.items[0]).to.have.property('producto', Number(pm.collectionVariables.get('producto_id')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            ""
          ]
        },
        "description": "Crea el pedido desde el carrito actual. El checkout vacía el carrito y descuenta el stock."
      },
      "response": []
    }
  ]
}
