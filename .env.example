# Configuración de Django
DEBUG=True
SECRET_KEY=django-insecure-repilche-secret-key-change-in-production

# Base de Datos PostgreSQL (Supabase)
# Ejemplo: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Hosts Permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - Frontend Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alias Oficial de Repilche para pagos
REPILCHE_ALIAS_PAGO=REPILCHE.OFICIAL.TRELEW
