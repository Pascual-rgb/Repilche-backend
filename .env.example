# Configuración de Django
# Para desarrollo local. En producción, usar DEBUG=False.
DEBUG=True
# Generar una clave larga y aleatoria, única por entorno; no reutilizar esta clave en producción.
SECRET_KEY=repilche-dev-example-7f4c9a2d8e1b6c3f0a5d9e2b7c4f1a8d6e3b0c5f9a2d7e4b1c8f3a6d0e5b9c2

# Base de Datos PostgreSQL (Supabase)
# Ejemplo: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Hosts permitidos separados por coma. En producción, reemplazar por los hosts reales.
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - Frontend Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Orígenes confiables para CSRF, separados por coma. En producción, agregar el dominio HTTPS real del frontend.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alias Oficial de Repilche para pagos
REPILCHE_ALIAS_PAGO=repilche
REPILCHE_TITULAR_PAGO=Maia Hernandez
